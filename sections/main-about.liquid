{%- comment -%}
  Editorial Minimalist About Page Section - SlideLab
{%- endcomment -%}

<div class="about-page">
  {% comment %} Hero Section {% endcomment %}
  <section class="about-hero">
    <div class="about-hero__inner">
      <span class="about-hero__eyebrow">OUR STORY</span>
      <h1 class="about-hero__title">Engineered for Professional Success</h1>
      <p class="about-hero__subtitle">SlideLab was born from a simple observation: most presentation templates are designed for designers, not for the professionals who actually use them.</p>
    </div>
  </section>

  {% comment %} Story Section {% endcomment %}
  <section class="about-story">
    <div class="about-story__inner">
      <div class="about-story__content">
        <h2 class="about-story__title">The Problem We Solve</h2>
        <p class="about-story__text">Every year, executives, consultants, and founders waste hundreds of hours building presentations from scratch or customizing generic templates that don't fit their needs.</p>
        <p class="about-story__text">The result? Sloppy decks that undermine credibility, missed opportunities, and lost deals.</p>
        <p class="about-story__text">We built SlideLab to change that. Every template is engineered around real business use cases — investor pitches, annual reports, strategy decks, and client proposals — with the precision and authority that high-stakes presentations demand.</p>
      </div>
    </div>
  </section>

  {% comment %} Values Section {% endcomment %}
  <section class="about-values">
    <div class="about-values__inner">
      <div class="about-values__grid">
        <div class="value-card">
          <div class="value-card__number">01</div>
          <h3 class="value-card__title">Quality Over Quantity</h3>
          <p class="value-card__desc">We release fewer templates than competitors, but each one is meticulously crafted and tested by real professionals before launch.</p>
        </div>
        <div class="value-card">
          <div class="value-card__number">02</div>
          <h3 class="value-card__title">Business-First Design</h3>
          <p class="value-card__desc">Every slide is built around actual business content — not placeholder lorem ipsum. Financial models, KPI dashboards, and strategy frameworks come pre-built.</p>
        </div>
        <div class="value-card">
          <div class="value-card__number">03</div>
          <h3 class="value-card__title">Universal Compatibility</h3>
          <p class="value-card__desc">PowerPoint, Keynote, and Google Slides — every template works seamlessly across all three platforms, so you can present from any device.</p>
        </div>
        <div class="value-card">
          <div class="value-card__number">04</div>
          <h3 class="value-card__title">Lifetime Partnership</h3>
          <p class="value-card__desc">Pay once, own forever. We continuously update our templates with new slides, features, and improvements — all free for existing customers.</p>
        </div>
      </div>
    </div>
  </section>

  {% comment %} Stats Section {% endcomment %}
  <section class="about-stats">
    <div class="about-stats__inner">
      <div class="stat-item">
        <div class="stat-item__number">12,000+</div>
        <div class="stat-item__label">Professionals Served</div>
      </div>
      <div class="stat-item">
        <div class="stat-item__number">150+</div>
        <div class="stat-item__label">Slides Per Template</div>
      </div>
      <div class="stat-item">
        <div class="stat-item__number">3</div>
        <div class="stat-item__label">Formats Included</div>
      </div>
      <div class="stat-item">
        <div class="stat-item__number">30-Day</div>
        <div class="stat-item__label">Money-Back Guarantee</div>
      </div>
    </div>
  </section>

  {% comment %} CTA Section {% endcomment %}
  <section class="about-cta">
    <div class="about-cta__inner">
      <h2 class="about-cta__title">Ready to Elevate Your Presentations?</h2>
      <p class="about-cta__desc">Join thousands of professionals who trust SlideLab for their most important presentations.</p>
      <div class="about-cta__buttons">
        <a href="/collections/all" class="btn">Browse Templates</a>
        <a href="/pages/free-presentation-slides" class="btn btn--outline">Get Free Slides</a>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Main About",
  "settings": []
}
{% endschema %}
