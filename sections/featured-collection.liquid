{%- comment -%}
  Clean Shopify OS 2.0 Base Featured Collection Section
{%- endcomment -%}

<div class="featured-collection-section" style="padding: 3rem 0;">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h2 style="font-size: 1.8rem;">{{ section.settings.title }}</h2>
        {%- if section.settings.show_view_all and section.settings.collection != blank -%}
          <a href="{{ section.settings.collection.url }}" style="font-weight: 500; color: var(--color-base-accent);">
            {{ 'sections.featured_collection.view_all' | t }} &rarr;
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign collection = section.settings.collection -%}
    {%- assign products_to_show = section.settings.products_to_show | default: 4 -%}

    <div class="grid grid-cols-4">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: products_to_show -%}
          {% render 'product-card', card_product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          <div class="card" style="padding: 1.5rem; text-align: center; background: #fafafa;">
            <div style="background: #e5e5e5; height: 180px; margin-bottom: 1rem; border-radius: 4px;"></div>
            <h3 style="font-size: 1rem; margin-bottom: 0.5rem;">Sample Product {{ i }}</h3>
            <p style="font-weight: bold;">$29.00</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Enable 'View all' link"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
