{%- comment -%}
  Header Section - SlideLab Editorial Minimalist
{%- endcomment -%}

<header class="site-header" id="SiteHeader">
  <div class="site-header__container">
    
    <!-- Mobile Hamburger Trigger (Left on Mobile) -->
    <div class="site-header__hamburger-wrapper">
      <button type="button" class="site-header__hamburger" id="MobileNavOpen" aria-label="Open navigation menu" aria-expanded="false">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Logo (Left on Desktop, Centered on Mobile) -->
    <div class="site-header__logo-wrapper">
      <a href="{{ routes.root_url }}" class="site-header__logo">
        {{ section.settings.logo_text | default: "SlideLab" }}
      </a>
    </div>

    <!-- Desktop Navigation (Center on Desktop) -->
    <nav class="site-header__nav" aria-label="Main Navigation">
      {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="site-header__link">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/collections/business" class="site-header__link">Business</a>
        <a href="/collections/marketing" class="site-header__link">Marketing</a>
        <a href="/collections/startups" class="site-header__link">Startups</a>
        <a href="/collections/consulting" class="site-header__link">Consulting</a>
        <a href="/collections/bundles" class="site-header__link">Bundles</a>
      {%- endif -%}
    </nav>

    <!-- Right Icons (Cart) -->
    <div class="site-header__icons">
      <a href="{{ routes.cart_url }}" class="site-header__cart-link" aria-label="Shopping Cart">
        <svg class="site-header__cart-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="site-header__cart-badge" id="CartCountBadge">
          {{ cart.item_count }}
        </span>
      </a>
    </div>

  </div>
</header>

<!-- Mobile Drawer & Overlay -->
<div class="mobile-drawer-overlay" id="MobileDrawerOverlay"></div>
<aside class="mobile-drawer" id="MobileDrawer" aria-hidden="true">
  <div class="mobile-drawer__header">
    <span class="site-header__logo" style="font-size: 22px;">SlideLab</span>
    <button type="button" class="mobile-drawer__close" id="MobileNavClose" aria-label="Close navigation menu">&times;</button>
  </div>
  <nav class="mobile-drawer__nav" aria-label="Mobile Navigation">
    {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}" class="mobile-drawer__link">{{ link.title }}</a>
      {%- endfor -%}
    {%- else -%}
      <a href="/collections/business" class="mobile-drawer__link">Business</a>
      <a href="/collections/marketing" class="mobile-drawer__link">Marketing</a>
      <a href="/collections/startups" class="mobile-drawer__link">Startups</a>
      <a href="/collections/consulting" class="mobile-drawer__link">Consulting</a>
      <a href="/collections/bundles" class="mobile-drawer__link">Bundles</a>
    {%- endif -%}
  </nav>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const openBtn = document.getElementById('MobileNavOpen');
    const closeBtn = document.getElementById('MobileNavClose');
    const drawer = document.getElementById('MobileDrawer');
    const overlay = document.getElementById('MobileDrawerOverlay');

    function openDrawer() {
      if (drawer && overlay) {
        drawer.classList.add('is-active');
        overlay.classList.add('is-active');
        drawer.setAttribute('aria-hidden', 'false');
        if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeDrawer() {
      if (drawer && overlay) {
        drawer.classList.remove('is-active');
        overlay.classList.remove('is-active');
        drawer.setAttribute('aria-hidden', 'true');
        if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    }

    if (openBtn) openBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (overlay) overlay.addEventListener('click', closeDrawer);
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "SlideLab"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
