{%- comment -%}
  Clean Shopify OS 2.0 Main Product Section
{%- endcomment -%}

<div class="product-section page-width" style="padding: 3rem 0;">
  <div class="grid grid-cols-2" style="gap: 3rem; align-items: start;">
    
    <!-- Product Gallery -->
    <div class="product-media">
      {%- if product.featured_media -%}
        <img src="{{ product.featured_media | image_url: width: 800 }}" alt="{{ product.featured_media.alt | escape }}" width="800" height="auto" style="border-radius: 6px; border: 1px solid var(--color-base-border);">
      {%- else -%}
        <div style="background: #f4f4f4; height: 400px; display: flex; align-items: center; justify-content: center; border-radius: 6px;">
          <span>No image available</span>
        </div>
      {%- endif -%}
    </div>

    <!-- Product Info Form -->
    <div class="product-info">
      <h1 style="font-size: 2rem; margin-bottom: 0.5rem;">{{ product.title }}</h1>
      <div style="font-size: 1.5rem; font-weight: bold; margin-bottom: 1.5rem;">
        {{ product.price | money }}
      </div>

      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        
        <div style="margin-bottom: 1.5rem;">
          <label for="Quantity" style="display: block; margin-bottom: 0.5rem;">{{ 'products.product.quantity' | t }}</label>
          <input type="number" id="Quantity" name="quantity" value="1" min="1" style="width: 80px; padding: 0.5rem; border: 1px solid var(--color-base-border); border-radius: 4px;">
        </div>

        <button type="submit" class="button" style="width: 100%; padding: 1rem;" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}
            {{ 'products.product.add_to_cart' | t }}
          {% else %}
            {{ 'products.product.sold_out' | t }}
          {% endif %}
        </button>
      {% endform %}

      <div style="margin-top: 2rem; line-height: 1.6; color: #444;">
        {{ product.description }}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
