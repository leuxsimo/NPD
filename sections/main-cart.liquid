{%- comment -%}
  Clean Shopify OS 2.0 Main Cart Section
{%- endcomment -%}

<div class="cart-section page-width" style="padding: 3rem 0;">
  <h1 style="font-size: 2rem; margin-bottom: 2rem;">{{ 'sections.cart.title' | t }}</h1>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 2rem;">
        <thead>
          <tr style="border-bottom: 1px solid var(--color-base-border); text-align: left;">
            <th style="padding: 1rem 0;">{{ 'sections.cart.heading.product' | t }}</th>
            <th style="padding: 1rem 0;">{{ 'sections.cart.heading.quantity' | t }}</th>
            <th style="padding: 1rem 0; text-align: right;">{{ 'sections.cart.heading.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr style="border-bottom: 1px solid var(--color-base-border);">
              <td style="padding: 1rem 0; display: flex; items-center; gap: 1rem;">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title | escape }}" width="80" height="auto" style="border-radius: 4px;">
                {% endif %}
                <div>
                  <a href="{{ item.url }}" style="font-weight: 500;">{{ item.product.title }}</a>
                  <p style="color: #666; font-size: 0.9rem;">{{ item.price | money }}</p>
                </div>
              </td>
              <td style="padding: 1rem 0;">
                <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" style="width: 60px; padding: 0.4rem; border: 1px solid var(--color-base-border); border-radius: 4px;">
              </td>
              <td style="padding: 1rem 0; text-align: right; font-weight: bold;">
                {{ item.final_line_price | money }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 1rem;">
        <div style="font-size: 1.3rem; font-weight: bold;">
          {{ 'sections.cart.subtotal' | t }}: {{ cart.total_price | money }}
        </div>
        <div style="display: flex; gap: 1rem;">
          <button type="submit" name="update" class="button button--secondary">Update Cart</button>
          <button type="submit" name="checkout" class="button">{{ 'sections.cart.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {% else %}
    <div style="text-align: center; padding: 3rem 0;">
      <p style="margin-bottom: 1.5rem;">{{ 'sections.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'sections.cart.continue_shopping' | t }}</a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
