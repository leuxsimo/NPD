{%- comment -%}
  Editorial Minimalist Lead Magnet / Free Starter Kit - SlideLab
{%- endcomment -%}

<div class="lead-magnet">
  <div class="lead-magnet__inner">
    <div class="lead-magnet__content">
      <span class="lead-magnet__eyebrow">FREE STARTER KIT</span>
      <h1 class="lead-magnet__title">Get 5 Premium Slides + 15% Off Your First Order</h1>
      <p class="lead-magnet__desc">Join 12,000+ professionals who receive our Ultimate Business Presentation Starter Kit — including:</p>
      
      <div class="lead-magnet__slides">
        <div class="slide-preview">
          <div class="slide-preview__image">
            <div class="slide-preview__placeholder">EXECUTIVE COVER</div>
          </div>
          <span class="slide-preview__label">1. Executive Cover Slide</span>
        </div>
        <div class="slide-preview">
          <div class="slide-preview__image">
            <div class="slide-preview__placeholder">AGENDA</div>
          </div>
          <span class="slide-preview__label">2. Professional Agenda</span>
        </div>
        <div class="slide-preview">
          <div class="slide-preview__image">
            <div class="slide-preview__placeholder">STRATEGY</div>
          </div>
          <span class="slide-preview__label">3. Strategy Slide</span>
        </div>
        <div class="slide-preview">
          <div class="slide-preview__image">
            <div class="slide-preview__placeholder">FINANCIAL</div>
          </div>
          <span class="slide-preview__label">4. Financial Overview</span>
        </div>
        <div class="slide-preview">
          <div class="slide-preview__image">
            <div class="slide-preview__placeholder">CLOSING</div>
          </div>
          <span class="slide-preview__label">5. Closing Slide</span>
        </div>
      </div>
      
      <div class="lead-magnet__form-wrapper">
        <form class="lead-magnet__form" action="/contact#lead-magnet-form" method="post" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          
          <div class="lead-magnet__input-group">
            <input 
              type="email" 
              name="contact[email]" 
              class="lead-magnet__input" 
              placeholder="Enter your work email" 
              required 
              autocomplete="email"
              aria-label="Email address"
            >
            <button type="submit" class="lead-magnet__btn">Send Me The Kit</button>
          </div>
          
          <div class="lead-magnet__benefits">
            <div class="benefit-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>5 premium slides (PPTX, KEY, GSlides)</span>
            </div>
            <div class="benefit-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>Exclusive 15% discount code: <strong>WELCOME15</strong></span>
            </div>
            <div class="benefit-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>Instant download</span>
            </div>
            <div class="benefit-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>No spam, unsubscribe anytime</span>
            </div>
          </div>
        </form>
        
        <div class="lead-magnet__success-message" style="display: none;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="48" height="48">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <h3>You're In! Check Your Email</h3>
          <p>We've sent your free slides and discount code to your inbox.</p>
          <p class="lead-magnet__code-display">Your Code: <strong>WELCOME15</strong></p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main Lead Magnet",
  "settings": []
}
{% endschema %}
