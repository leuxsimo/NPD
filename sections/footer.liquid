{%- comment -%}
  Editorial Minimalist Footer Section - SlideLab
{%- endcomment -%}

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <!-- Column 1: Brand -->
      <div class="footer__col footer__col--brand">
        <div class="footer__logo">SlideLab</div>
        <p class="footer__tagline">
          {{ section.settings.tagline | default: "Premium presentation systems for executives, founders, and consultants. High-impact slide templates built for high-stakes pitches." }}
        </p>
        <p class="footer__shipping-note">
          <svg class="footer__shipping-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
          Digital products only. No physical shipping.
        </p>
      </div>

      <!-- Column 2: Collections -->
      <div class="footer__col">
        {% assign collections_menu = linklists[section.settings.menu_collections] | default: linklists['footer-collections'] %}
        {% if collections_menu != blank and collections_menu.links.size > 0 %}
          <h4 class="footer__heading">{{ collections_menu.title | default: "Collections" }}</h4>
          <ul class="footer__links">
            {% for link in collections_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% else %}
          <h4 class="footer__heading">Collections</h4>
          <ul class="footer__links">
            {% if collections.size > 0 %}
              {% for collection in collections limit: 5 %}
                <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/collections/all">All Templates</a></li>
              <li><a href="/collections/business">Business</a></li>
              <li><a href="/collections/marketing">Marketing</a></li>
              <li><a href="/collections/startups">Startups</a></li>
              <li><a href="/collections/consulting">Consulting</a></li>
            {% endif %}
          </ul>
        {% endif %}
      </div>

      <!-- Column 3: Company -->
      <div class="footer__col">
        {% assign company_menu = linklists[section.settings.menu_company] | default: linklists['footer-company'] %}
        {% if company_menu != blank and company_menu.links.size > 0 %}
          <h4 class="footer__heading">{{ company_menu.title | default: "Company" }}</h4>
          <ul class="footer__links">
            {% for link in company_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% else %}
          <h4 class="footer__heading">Company</h4>
          <ul class="footer__links">
            <li><a href="/pages/about-slidelab">About</a></li>
            <li><a href="/blogs/news">Blog</a></li>
            <li><a href="/pages/contact">Contact</a></li>
            <li><a href="/pages/free-presentation-slides">Free Starter Kit</a></li>
          </ul>
        {% endif %}
      </div>

      <!-- Column 4: Support -->
      <div class="footer__col">
        {% assign support_menu = linklists[section.settings.menu_support] | default: linklists['footer-support'] %}
        {% if support_menu != blank and support_menu.links.size > 0 %}
          <h4 class="footer__heading">{{ support_menu.title | default: "Support" }}</h4>
          <ul class="footer__links">
            {% for link in support_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% else %}
          <h4 class="footer__heading">Support</h4>
          <ul class="footer__links">
            <li><a href="/pages/faq">FAQ</a></li>
            <li><a href="/pages/download-guide">Download Guide</a></li>
            <li><a href="/pages/license">License</a></li>
            <li><a href="/pages/refund-policy">Refund Policy</a></li>
          </ul>
        {% endif %}
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer__bottom">
      <div class="footer__legal">
        {% assign legal_menu = linklists['footer-legal'] | default: linklists['legal-menu'] %}
        {% if legal_menu != blank and legal_menu.links.size > 0 %}
          {% for link in legal_menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a href="/pages/privacy-policy">Privacy Policy</a>
          <a href="/pages/terms-of-service">Terms of Service</a>
        {% endif %}
      </div>
      <div class="footer__copyright">
        © {{ 'now' | date: "%Y" }}, SlideLab. All rights reserved.
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "Premium presentation systems for executives, founders, and consultants. High-impact slide templates built for high-stakes pitches."
    },
    {
      "type": "link_list",
      "id": "menu_collections",
      "label": "Collections Menu",
      "default": "footer-collections"
    },
    {
      "type": "link_list",
      "id": "menu_company",
      "label": "Company Menu",
      "default": "footer-company"
    },
    {
      "type": "link_list",
      "id": "menu_support",
      "label": "Support Menu",
      "default": "footer-support"
    }
  ]
}
{% endschema %}
