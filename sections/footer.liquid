{%- comment -%}
  SlideLab Editorial Minimalist Footer Section
{%- endcomment -%}

<footer class="site-footer" style="border-top: 1px solid var(--color-border); padding: 4rem 0 2rem 0; margin-top: 4rem; background-color: var(--color-bg);">
  <div class="page-width">
    <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 3rem; margin-bottom: 3rem;">
      
      <!-- Brand & About Column -->
      <div style="max-width: 400px;">
        <h4 style="font-family: var(--font-heading); font-size: 24px; font-weight: 600; letter-spacing: 0.05em; margin-bottom: 1rem; color: var(--color-text);">
          SlideLab
        </h4>
        <p style="font-family: var(--font-body); color: #555553; font-size: 14px; line-height: 1.6;">
          {{ section.settings.about_text | default: "Engineered presentation systems for executives, founders, and consultants. High-impact slide templates built for high-stakes pitches." }}
        </p>
      </div>

      <!-- Quick Links Column -->
      <div>
        <h5 style="font-family: var(--font-body); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1.25rem; color: var(--color-text);">
          Quick Links
        </h5>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem;">
          {%- if section.settings.footer_menu != blank and section.settings.footer_menu.links.size > 0 -%}
            {%- for link in section.settings.footer_menu.links -%}
              <li><a href="{{ link.url }}" style="font-family: var(--font-body); font-size: 14px; color: #555553; text-decoration: none; transition: color 0.2s ease;">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/collections/all" style="font-family: var(--font-body); font-size: 14px; color: #555553; text-decoration: none;">All Systems</a></li>
            <li><a href="/pages/about" style="font-family: var(--font-body); font-size: 14px; color: #555553; text-decoration: none;">About SlideLab</a></li>
            <li><a href="/pages/faq" style="font-family: var(--font-body); font-size: 14px; color: #555553; text-decoration: none;">FAQ</a></li>
            <li><a href="/pages/contact" style="font-family: var(--font-body); font-size: 14px; color: #555553; text-decoration: none;">Contact</a></li>
          {%- endif -%}
        </ul>
      </div>

    </div>

    <!-- Copyright -->
    <div style="border-top: 1px solid var(--color-border); padding-top: 1.5rem; text-align: center; color: #777; font-family: var(--font-body); font-size: 13px;">
      &copy; 2026, SlideLab. All rights reserved.
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "Engineered presentation systems for executives, founders, and consultants. High-impact slide templates built for high-stakes pitches."
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "default": "footer",
      "label": "Footer Menu"
    }
  ]
}
{% endschema %}
