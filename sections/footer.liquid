<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      {% comment %} Brand Column {% endcomment %}
      <div class="site-footer__col site-footer__col--brand">
        <div class="site-footer__logo">SlideLab</div>
        <p class="site-footer__tagline">Premium presentation systems for executives, founders, and consultants.</p>
        <p class="site-footer__digital-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
          </svg>
          Digital products only. No physical shipping.
        </p>
      </div>

      {% comment %} Dynamic Menu Columns {% endcomment %}
      {% assign footer_menus = 'footer-collections,footer-company,footer-support' | split: ',' %}
      
      {% for menu_handle in footer_menus %}
        {% assign menu = linklists[menu_handle] %}
        {% if menu != blank %}
          <div class="site-footer__col">
            <h4 class="site-footer__heading">{{ menu.title }}</h4>
            <ul class="site-footer__links">
              {% for link in menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% comment %} Bottom Bar {% endcomment %}
    <div class="site-footer__bottom">
      <div class="site-footer__legal">
        <a href="/pages/privacy-policy">Privacy Policy</a>
        <a href="/pages/terms-of-service">Terms of Service</a>
      </div>
      <div class="site-footer__copyright">
        © 2026, SlideLab. All rights reserved.
      </div>
    </div>
  </div>
</footer>
