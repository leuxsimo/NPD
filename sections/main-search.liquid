{%- comment -%}
  Clean Shopify OS 2.0 Main Search Section
{%- endcomment -%}

<div class="search-section page-width" style="padding: 3rem 0;">
  <h1 style="font-size: 2rem; margin-bottom: 1.5rem; text-align: center;">{{ 'general.search.title' | t }}</h1>

  <div style="max-width: 500px; margin: 0 auto 3rem auto;">
    <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; gap: 0.5rem;">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        style="flex: 1; padding: 0.75rem; border: 1px solid var(--color-base-border); border-radius: 4px;"
      >
      <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      {% paginate search.results by 12 %}
        <div class="grid grid-cols-4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item %}
            {%- else -%}
              <div class="card" style="padding: 1rem;">
                <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                <p style="color: #666; font-size: 0.9rem; margin-top: 0.5rem;">{{ item.content | strip_html | truncatewords: 20 }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div style="margin-top: 3rem; text-align: center;">
            {{ paginate | default_pagination }}
          </div>
        {%- endif -%}
      {% endpaginate %}
    {%- else -%}
      <p style="text-align: center; color: #666;">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Main Search",
  "settings": []
}
{% endschema %}
