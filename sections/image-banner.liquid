{%- comment -%}
  Editorial Minimalist Banner / Hero Section
{%- endcomment -%}

<div class="banner-section" style="padding: clamp(4rem, 8vw, 8rem) 0; border-bottom: 1px solid var(--color-border);">
  <div class="page-width" style="text-align: center; max-width: 900px;">
    
    <span style="font-family: var(--font-body); font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: #666; margin-bottom: 16px; display: block;">
      Editorial Presentation Systems
    </span>

    <h1>
      {{ section.settings.heading | default: "High-End Presentation Systems for High-Stakes Pitches" }}
    </h1>

    <p style="font-size: 18px; color: #555; margin: 24px auto 40px auto; max-width: 640px;">
      {{ section.settings.text | default: "Engineered for executives, founders, and consultants. Fully customizable templates for PowerPoint, Keynote, and Google Slides." }}
    </p>

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Image Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "High-End Presentation Systems for High-Stakes Pitches"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Engineered for executives, founders, and consultants. Fully customizable templates for PowerPoint, Keynote, and Google Slides."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image Banner"
    }
  ]
}
{% endschema %}
