{%- comment -%}
  Editorial Minimalist FAQ Accordion Section - SlideLab
{%- endcomment -%}

<section class="faq">
  <div class="faq__inner">
    <div class="faq__header">
      <span class="faq__eyebrow">
        {{ section.settings.eyebrow | default: "COMMON QUESTIONS" }}
      </span>
      <h2 class="faq__title">
        {{ section.settings.title | default: "Frequently Asked Questions" }}
      </h2>
      <p class="faq__subtitle">
        {{ section.settings.subtitle | default: "Everything you need to know about SlideLab templates, licensing, and delivery." }}
      </p>
    </div>
    <div class="faq__list">
      <div class="faq-item">
        <button class="faq-item__question" aria-expanded="false" type="button">
          <span>What formats are included with each template?</span>
          <span class="faq-item__icon">+</span>
        </button>
        <div class="faq-item__answer">
          <p>Every template includes three formats: PowerPoint (.PPTX), Apple Keynote (.KEY), and Google Slides. All formats are fully editable and compatible with their respective platforms.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-item__question" aria-expanded="false" type="button">
          <span>Can I use these templates for commercial projects?</span>
          <span class="faq-item__icon">+</span>
        </button>
        <div class="faq-item__answer">
          <p>Yes. All templates come with a commercial license. You can use them for client projects, internal presentations, and any business purpose without restrictions or additional fees.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-item__question" aria-expanded="false" type="button">
          <span>How do I receive the templates after purchase?</span>
          <span class="faq-item__icon">+</span>
        </button>
        <div class="faq-item__answer">
          <p>Templates are delivered instantly via email after checkout. You'll receive download links for all three formats (PPTX, KEY, GSlides) along with a quick-start guide.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-item__question" aria-expanded="false" type="button">
          <span>Are the templates easy to customize?</span>
          <span class="faq-item__icon">+</span>
        </button>
        <div class="faq-item__answer">
          <p>Absolutely. Every element is fully editable - colors, fonts, layouts, images, and text. No design skills required. We also include a customization guide with each template.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-item__question" aria-expanded="false" type="button">
          <span>What is your refund policy?</span>
          <span class="faq-item__icon">+</span>
        </button>
        <div class="faq-item__answer">
          <p>We offer a 30-day money-back guarantee. If you're not satisfied with the quality of the template, contact us within 30 days for a full refund, no questions asked.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-item__question" aria-expanded="false" type="button">
          <span>Do you offer updates after purchase?</span>
          <span class="faq-item__icon">+</span>
        </button>
        <div class="faq-item__answer">
          <p>Yes. All templates include lifetime free updates. When we improve a template or add new slides, you'll receive the updated version at no additional cost.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqItems = document.querySelectorAll('.faq-item');
    
    faqItems.forEach(item => {
      const question = item.querySelector('.faq-item__question');
      if (!question) return;
      
      question.addEventListener('click', function() {
        const isActive = item.classList.contains('active');
        
        // Close all items
        faqItems.forEach(i => {
          i.classList.remove('active');
          const q = i.querySelector('.faq-item__question');
          if (q) q.setAttribute('aria-expanded', 'false');
        });
        
        // Open clicked item if it wasn't active
        if (!isActive) {
          item.classList.add('active');
          question.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "COMMON QUESTIONS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need to know about SlideLab templates, licensing, and delivery."
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
