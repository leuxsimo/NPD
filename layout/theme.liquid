<!DOCTYPE html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>
    {{ page_title }}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap">

  {{ content_for_header }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'component-header.css' | asset_url | stylesheet_tag }}
  {{ 'component-hero.css' | asset_url | stylesheet_tag }}
  {{ 'component-trust-bar.css' | asset_url | stylesheet_tag }}
  {{ 'component-format-cards.css' | asset_url | stylesheet_tag }}
  {{ 'component-best-sellers.css' | asset_url | stylesheet_tag }}
  {{ 'component-how-it-works.css' | asset_url | stylesheet_tag }}
  {{ 'component-benefits-grid.css' | asset_url | stylesheet_tag }}
  {{ 'component-featured-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-testimonials.css' | asset_url | stylesheet_tag }}
  {{ 'component-bundle-banner.css' | asset_url | stylesheet_tag }}
  {{ 'component-faq.css' | asset_url | stylesheet_tag }}
  {{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
  {{ 'component-footer.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
</head>

<body>
  <a class="sr-only" href="#MainContent">Skip to content</a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
</body>
</html>